// 5.1 — Analyze Logs (JSON payload)
const analyzeLogs = async (logs, { description = null, model_name = null, user = "admin", responseFormat = "json" } = {}) => {
  const body = { logs };
  if (description) body.description = description;
  if (model_name) body.model_name = model_name;
  if (user) body.user = user;

  const res = await fetch(`${API_BASE}/api/analyze?response_format=${responseFormat}`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });
  if (!res.ok) {
    const err = await res.json();
    throw new Error(err.detail || "Analysis failed");
  }

  // "text" format returns plain text, "json" returns structured JSON
  if (responseFormat === "text") {
    return res.text();
  }
  return res.json();
};

// Usage:
// const result = await analyzeLogs("2026-05-10T10:23:45Z ERROR OOM killed process");
// const result = await analyzeLogs(logText, { description: "K8s logs", responseFormat: "json" });


// 5.2 — Analyze Logs (File Upload)
const analyzeLogFile = async (file, responseFormat = "json") => {
  const formData = new FormData();
  formData.append("file", file); // file is a File object from <input type="file">

  const res = await fetch(`${API_BASE}/api/analyze?response_format=${responseFormat}`, {
    method: "POST",
    body: formData,
    // NOTE: Do NOT set Content-Type header — the browser sets it
    //       automatically with the correct multipart boundary.
  });
  if (!res.ok) {
    const err = await res.json();
    throw new Error(err.detail || "File analysis failed");
  }

  if (responseFormat === "text") {
    return res.text();
  }
  return res.json();
};

