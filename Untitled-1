// 6.2 — Filter History (with optional params)
const filterHistory = async ({ status = null, model_name = null, analysis_code = null, content_query = null } = {}) => {
  const params = new URLSearchParams();
  if (status) params.append("status", status);
  if (model_name) params.append("model_name", model_name);
  if (analysis_code) params.append("analysis_code", analysis_code);
  if (content_query) params.append("content_query", content_query);

  const res = await fetch(`${API_BASE}/api/history?${params.toString()}`);
  if (!res.ok) throw new Error("Failed to fetch filtered history");
  return res.json();
};

